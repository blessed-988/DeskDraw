<Window x:Class="DeskDraw.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.Resources>
        <Style TargetType="Border">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Wallpaper Image -->
        <Image x:Name="WallpaperImage"
               Grid.Row="0"
               Stretch="UniformToFill" />

        <!-- Drawing Canvas -->
        <Canvas x:Name="DrawCanvas"
                Grid.Row="0"
                Background="Transparent" 
                MouseLeftButtonDown="DrawCanvas_MouseLeftButtonDown"
                MouseMove="DrawCanvas_MouseMove"
                MouseLeftButtonUp="DrawCanvas_MouseLeftButtonUp"
                MouseLeave="DrawCanvas_MouseLeave" />

        <!-- Floating Toolbar -->
        <Border x:Name="Toolbar"
                Grid.Row="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="10,10,0,0"
                Background="#DD1A1A1A"
                BorderBrush="#55FFFFFF"
                BorderThickness="1"
                CornerRadius="10"
                MouseLeftButtonUp="Toolbar_MouseLeftButtonUp"
                MouseMove="Toolbar_MouseMove">
            <StackPanel Orientation="Horizontal" Margin="8,4" VerticalAlignment="Top">

                <!-- Drag Grip -->
                <Border
                        Width="32" Height="32"
                        Background="Transparent"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="Grip_MouseLeftButtonDown"
                        MouseLeftButtonUp="Grip_MouseLeftButtonUp">
                    <Grid Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Row="0" Grid.Column="0" Width="3" Height="3" Fill="#88FFFFFF" />
                        <Ellipse Grid.Row="0" Grid.Column="1" Width="3" Height="3" Fill="#88FFFFFF" />
                        <Ellipse Grid.Row="0" Grid.Column="2" Width="3" Height="3" Fill="#88FFFFFF" />
                        <Ellipse Grid.Row="1" Grid.Column="0" Width="3" Height="3" Fill="#88FFFFFF" />
                        <Ellipse Grid.Row="1" Grid.Column="1" Width="3" Height="3" Fill="#88FFFFFF" />
                        <Ellipse Grid.Row="1" Grid.Column="2" Width="3" Height="3" Fill="#88FFFFFF" />
                        <Ellipse Grid.Row="2" Grid.Column="0" Width="3" Height="3" Fill="#88FFFFFF" />
                        <Ellipse Grid.Row="2" Grid.Column="1" Width="3" Height="3" Fill="#88FFFFFF" />
                        <Ellipse Grid.Row="2" Grid.Column="2" Width="3" Height="3" Fill="#88FFFFFF" />
                    </Grid>
                </Border>

                <!-- Tool Selector -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Brush Tool -->
                    <Border x:Name="BrushIconBorder"
                            Width="28" Height="28"
                            Background="#33FFFFFF"
                            CornerRadius="5"
                            Margin="0,0,3,0"
                            Cursor="Hand"
                            MouseLeftButtonDown="BrushTool_Click">
                        <Canvas Width="16" Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Path Data="M3,14 L7,9 L9,11 L5,16 Z"
                                  Fill="#FFB74C"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="-45" />
                                </Path.RenderTransform>
                            </Path>
                            <Ellipse Canvas.Left="7" Canvas.Top="1"
                                     Width="5" Height="5"
                                     Fill="#FFF5E6"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-45" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Canvas>
                    </Border>
                    <!-- Rectangle Tool -->
                    <Border x:Name="RectangleIconBorder"
                            Width="28" Height="28"
                            Background="#33FFFFFF"
                            CornerRadius="5"
                            Cursor="Hand"
                            MouseLeftButtonDown="RectangleTool_Click">
                        <Canvas Width="16" Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Rectangle Fill="#FFB74C"
                                       Width="11" Height="11"
                                       StrokeThickness="0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,1" />
                        </Canvas>
                    </Border>
                    <TextBlock x:Name="ToolNameText"
                               Text="Кисть"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#EEEEEE"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0" />
                </StackPanel>

                <!-- Divider -->
                <Border Width="1"
                        Background="#33FFFFFF"
                        Margin="0,6" />

                <!-- Color Palette -->
                <StackPanel
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- Red -->
                    <Border Width="20" Height="20"
                            Background="#FF0000"
                            CornerRadius="50"
                            Margin="2,0"
                            Cursor="Hand"
                            ToolTip="Красный"
                            BorderThickness="2"
                            Tag="#FF0000"
                            MouseLeftButtonDown="ColorDot_Clicked">
                    </Border>

                    <!-- Blue -->
                    <Border Width="20" Height="20"
                            Background="#0066FF"
                            CornerRadius="50"
                            Margin="2,0"
                            Cursor="Hand"
                            ToolTip="Синий"
                            Tag="#0066FF"
                            MouseLeftButtonDown="ColorDot_Clicked">
                    </Border>

                    <!-- Green -->
                    <Border Width="20" Height="20"
                            Background="#00CC44"
                            CornerRadius="50"
                            Margin="2,0"
                            Cursor="Hand"
                            ToolTip="Зелёный"
                            Tag="#00CC44"
                            MouseLeftButtonDown="ColorDot_Clicked">
                    </Border>

                    <!-- Black -->
                    <Border Width="20" Height="20"
                            Background="#1A1A1A"
                            CornerRadius="50"
                            Margin="2,0"
                            Cursor="Hand"
                            ToolTip="Чёрный"
                            Tag="#1A1A1A"
                            MouseLeftButtonDown="ColorDot_Clicked">
                    </Border>

                    <!-- White -->
                    <Border Width="20" Height="20"
                            Background="#F0F0F0"
                            CornerRadius="50"
                            Margin="2,0"
                            Cursor="Hand"
                            ToolTip="Белый"
                            BorderThickness="1"
                            BorderBrush="#666666"
                            Tag="#F0F0F0"
                            MouseLeftButtonDown="ColorDot_Clicked">
                    </Border>

                    <!-- Yellow -->
                    <Border Width="20" Height="20"
                            Background="#FFCC00"
                            CornerRadius="50"
                            Margin="2,0"
                            Cursor="Hand"
                            ToolTip="Жёлтый"
                            Tag="#FFCC00"
                            MouseLeftButtonDown="ColorDot_Clicked">
                    </Border>
                </StackPanel>

                <!-- Divider -->
                <Border Width="1"
                        Background="#33FFFFFF"
                        Margin="0,6" />

                <!-- Thickness -->
                <StackPanel
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0">
                    <TextBlock x:Name="ThicknessValue"
                               Text="5"
                               FontSize="11"
                               Foreground="White"
                               FontWeight="Medium"
                               Width="20"
                               HorizontalAlignment="Center"
                               Margin="0,0,4,0" />

                    <Slider x:Name="ThicknessSlider"
                            Width="80"
                            Minimum="1"
                            Maximum="50"
                            Value="5"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            ValueChanged="ThicknessSlider_ValueChanged" />

                    <!-- Brush Preview -->
                    <Border Width="32" Height="32"
                            Margin="6,0,2,0"
                            Background="#33FFFFFF"
                            CornerRadius="5"
                            VerticalAlignment="Center">
                        <Canvas x:Name="BrushPreview"
                                Width="32" Height="32" />
                    </Border>
                </StackPanel>

                <!-- Divider -->
                <Border Width="1"
                        Background="#33FFFFFF"
                        Margin="0,6" />

                <!-- Undo Button -->
                <Border x:Name="UndoButtonBorder"
                        Width="28" Height="28"
                        Background="#33FFFFFF"
                        CornerRadius="5"
                        Margin="6,0,2,0"
                        Cursor="Hand"
                        ToolTip="Отменить (Ctrl+Z)"
                        MouseLeftButtonDown="UndoButton_Click"
                        IsEnabled="{Binding IsUndoEnabled}">
                    <Canvas Width="16" Height="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Line X1="12" Y1="4" X2="4" Y2="4"
                              Stroke="#EEEEEE" StrokeThickness="1.5" />
                        <Line X1="4" Y1="4" X2="4" Y2="12"
                              Stroke="#EEEEEE" StrokeThickness="1.5" />
                        <Line X1="4" Y1="12" X2="12" Y2="12"
                              Stroke="#EEEEEE" StrokeThickness="1.5" />
                        <Line X1="9" Y1="9" X2="13" Y2="12"
                              Stroke="#EEEEEE" StrokeThickness="1.5" />
                        <Line X1="13" Y1="12" X2="9" Y2="15"
                              Stroke="#EEEEEE" StrokeThickness="1.5" />
                    </Canvas>
                </Border>

                <!-- Redo Button -->
                <Border x:Name="RedoButtonBorder"
                        Width="28" Height="28"
                        Background="#33FFFFFF"
                        CornerRadius="5"
                        Margin="2,0,8,0"
                        Cursor="Hand"
                        ToolTip="Вернуть (Ctrl+Shift+Z / Ctrl+Y)"
                        MouseLeftButtonDown="RedoButton_Click"
                        IsEnabled="{Binding IsRedoEnabled}">
                    <Canvas Width="16" Height="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Line X1="4" Y1="4" X2="12" Y2="4"
                              Stroke="#EEEEEE" StrokeThickness="1.5" />
                        <Line X1="12" Y1="4" X2="12" Y2="12"
                              Stroke="#EEEEEE" StrokeThickness="1.5" />
                        <Line X1="12" Y1="12" X2="4" Y2="12"
                              Stroke="#EEEEEE" StrokeThickness="1.5" />
                        <Line X1="7" Y1="9" X2="3" Y2="12"
                              Stroke="#EEEEEE" StrokeThickness="1.5" />
                        <Line X1="3" Y1="12" X2="7" Y2="15"
                              Stroke="#EEEEEE" StrokeThickness="1.5" />
                    </Canvas>
                </Border>

                <!-- Divider -->
                <Border Width="1"
                        Background="#33FFFFFF"
                        Margin="0,6" />

                <!-- Wallpaper Button -->
                <Border
                        Width="28" Height="28"
                        Background="#33FFFFFF"
                        CornerRadius="5"
                        Margin="6,0,8,0"
                        Cursor="Hand"
                        ToolTip="Обои рабочего стола (S / Ctrl+S)"
                        MouseLeftButtonDown="WallpaperButton_Click">
                    <Canvas Width="16" Height="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <!-- Monitor screen -->
                        <Rectangle Width="12" Height="8"
                                   Fill="#EEEEEE"
                                   Stroke="#AAAAAA"
                                   StrokeThickness="0.5"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,2" />
                        <!-- Monitor stand -->
                        <Line X1="7" Y1="13" X2="9" Y2="13"
                              Stroke="#AAAAAA"
                              StrokeThickness="1" />
                        <Line X1="5" Y1="13" X2="11" Y2="13"
                              Stroke="#AAAAAA"
                              StrokeThickness="1" />
                    </Canvas>
                </Border>

                <!-- Close Button -->
                <Border
                        Width="28" Height="28"
                        Background="#33FFFFFF"
                        CornerRadius="5"
                        Margin="6,0,8,0"
                        Cursor="Hand"
                        ToolTip="Закрыть (Esc / Q)"
                        MouseLeftButtonDown="CloseButton_Click">
                    <Canvas Width="16" Height="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Line X1="4" Y1="4" X2="12" Y2="12"
                              Stroke="#EEEEEE"
                              StrokeThickness="1.5" />
                        <Line X1="12" Y1="4" X2="4" Y2="12"
                              Stroke="#EEEEEE"
                              StrokeThickness="1.5" />
                    </Canvas>
                </Border>
            </StackPanel>
            </Border>
    </Grid>
</Window>
